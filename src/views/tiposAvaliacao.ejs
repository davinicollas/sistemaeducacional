<%- include('partials/header') %>
<%- include('partials/menu') %>
            <%- include("partials/css") %>
<%- include("partials/javascript", { javascript: ["tiposAvaliacao"] }) %>

<%
    tipos = typeof tipos !== 'undefined' ? tipos : {};
    let tiposList = Array.isArray(tipos.tipos) ? tipos.tipos : [];
%>

<div class="main-content">
  <section class="config-card">
     <div style="text-align: right;">
      <button type="button" class="btn-primary series-new-btn" onclick="openTiposModal(null)">+ Novo Tipo de Avaliação</button>
    </div>
    <div class="card-header">
      <div class="card-icon">✅</div>
      <div>
        <h2>Tipos de Avaliação</h2>
        <p>Nome, sigla e nota máxima.</p>
      </div>
    </div>
<div class="cards">
          <div class="card">
              <div class="card-icon"><i class="bi bi-people-fill"></i></div>
              <div>
                  <span>Total de tipos</span>
                  <span style="text-align: center;"><strong>
                          <%= tiposList.length %>
                      </strong></span>
              </div>
          </div>
          <div class="card">
              <div class="card-icon"><i class="bi bi-person-check-fill"></i></div>
              <div>
                  <span>Tipos ativos</span>
                  <span style="text-align: center;"><strong><%= tiposList.filter(t => String(t.status) !== '0').length %></strong></span>
              </div>
          </div>
          <div class="card">
              <div class="card-icon"><i class="bi bi-person-x-fill"></i></div>
              <div>
                  <span>Tipos inativos</span>
                  <span style="text-align: center;"><strong><%= tiposList.filter(t => String(t.status) === '0').length %></strong></span>
              </div>
    </div>
      </div>  
    <div class="card-body">
      <form id="tipos-form" action="/tipos-avaliacao" method="POST">
        <table class="series-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nome</th>
              <th>Sigla</th>
              <th>Nota Máxima</th>
              <th style="width: 10%">Ações</th>
            </tr>
          </thead>
          <tbody id="tipos-tbody">
            <% tiposList.forEach(function (s, idx) { %>
              <tr data-index="<%= idx %>" class="tipo-row">
                <td><span class="tipo-id"><%= s.id || '' %></span></td>
                <td><span class="tipo-nome"><%= s.nome || '' %></span></td>
                <td><span class="tipo-sigla"><%= s.sigla || '' %></span></td>
                <td><span class="tipo-nota"><%= s.nota_maxima || '' %></span></td>
                <td class="tipo-actions">
                  <button type="button" class="btn btn-sm btn-warning" onclick="openTiposModal(<%= idx %>)"><i class="bi bi-pencil"></i></button>
                  <button type="button" class="btn btn-sm btn-danger" onclick="excluirTipo(<%= s.id %>)"><i class="bi bi-trash"></i></button>
                </td>
                <td class="hidden-values" style="display:none">
                  <input type="hidden" data-field="id" name="tipos[<%= idx %>][id]" value="<%= s.id || '' %>" />
                  <input type="hidden" data-field="nome" name="tipos[<%= idx %>][nome]" value="<%= s.nome || '' %>" />
                  <input type="hidden" data-field="sigla" name="tipos[<%= idx %>][sigla]" value="<%= s.sigla || '' %>" />
                  <input type="hidden" data-field="notaMaxima" name="tipos[<%= idx %>][notaMaxima]" value="<%= s.nota_maxima || '' %>" />
                  <input type="hidden" data-field="status" name="tipos[<%= idx %>][status]" value="<%= s.status || '1' %>" />
                  <input type="hidden" data-field="text" name="tipos[<%= idx %>][text]" value="<%= s.text || '' %>" />
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <% if (!tiposList.length) { %>
          <p class="series-empty" id="tipos-empty">Nenhum tipo cadastrado ainda.</p>
        <% } %>
        <div id="to-delete"></div>
        <%- include('partials/botoes', { newAction: 'openTiposModal(null)' }) %>
      </form>
    </div>
  </section>
</div>

