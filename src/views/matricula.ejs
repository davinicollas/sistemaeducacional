<!-- ============================================================= -->
<!-- MODAL NOVA MATRÍCULA -->
<!-- ============================================================= -->

<div
    class="modal fade"
    id="modalMatricula"
    tabindex="-1"
>

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <div>

                    <h5 class="modal-title mb-1">
                        <i class="bi bi-person-plus me-2"></i>
                        Nova matrícula
                    </h5>

                    <small class="text-muted">
                        Vincule um aluno a uma turma.
                    </small>

                </div>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body">

                <form>

                    <div class="row g-3">

                        <!-- Aluno -->

                        <div class="col-md-8">

                            <label class="form-label">
                                Aluno <span class="text-danger">*</span>
                            </label>

                            <select class="form-select">

                                <option selected disabled>
                                    Selecione o aluno
                                </option>

                                <option>
                                    Ana Silva
                                </option>

                                <option>
                                    Pedro Santos
                                </option>

                                <option>
                                    João Oliveira
                                </option>

                            </select>

                        </div>


                        <!-- Turma -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Turma <span class="text-danger">*</span>
                            </label>

                            <select class="form-select">

                                <option selected>
                                    1º Ano A
                                </option>

                                <option>
                                    1º Ano B
                                </option>

                                <option>
                                    2º Ano A
                                </option>

                            </select>

                        </div>


                        <!-- Data -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Data da matrícula
                                <span class="text-danger">*</span>
                            </label>

                            <input
                                type="date"
                                class="form-control"
                                value="2026-09-03"
                            >

                        </div>


                        <!-- Status -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Status
                                <span class="text-danger">*</span>
                            </label>

                            <select class="form-select">

                                <option selected>
                                    Ativo
                                </option>

                                <option>
                                    Pendente
                                </option>

                                <option>
                                    Cancelado
                                </option>

                            </select>

                        </div>


                        <!-- Número -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Nº da matrícula
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                placeholder="Automático"
                                readonly
                            >

                        </div>


                        <!-- Observações -->

                        <div class="col-12">

                            <label class="form-label">
                                Observações
                            </label>

                            <textarea
                                class="form-control"
                                rows="3"
                                placeholder="Digite alguma observação..."
                            ></textarea>

                        </div>

                    </div>

                </form>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >
                    Cancelar
                </button>

                <button
                    type="button"
                    class="btn btn-primary"
                >
                    <i class="bi bi-check-lg me-1"></i>
                    Matricular aluno
                </button>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- MODAL IMPORTAÇÃO -->
<!-- ============================================================= -->

<div
    class="modal fade"
    id="modalImportar"
    tabindex="-1"
>

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    <i class="bi bi-file-earmark-excel me-2"></i>
                    Importar matrículas
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>

            </div>


            <div class="modal-body">

                <div class="alert alert-info">

                    <i class="bi bi-info-circle me-1"></i>

                    Utilize uma planilha no formato
                    <strong>.xlsx</strong>.

                </div>


                <label class="form-label">
                    Arquivo
                </label>

                <input
                    type="file"
                    class="form-control"
                    accept=".xlsx,.xls"
                >

                <div class="form-text mt-2">

                    A planilha deve conter:
                    aluno, turma, data da matrícula e status.

                </div>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >
                    Cancelar
                </button>

                <button
                    type="button"
                    class="btn btn-success"
                >
                    <i class="bi bi-upload me-1"></i>
                    Importar
                </button>

            </div>

        </div>

    </div>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js">
</script>


<script>

function abrirTurma(nomeTurma) {

    document.getElementById('nomeTurmaSelecionada').textContent = nomeTurma;

    const painel = document.getElementById('painelAlunos');

    painel.style.display = 'block';

    painel.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
    });
}

</script>

</body>
