<% 
const page = pagination?.page || 1;
const totalPages = pagination?.totalPages || 1;
const totalItems = pagination?.totalItems || 0;

let baseQuery = '';
if (typeof query !== 'undefined') {
  baseQuery = query ? query + '&' : '';
} else if (typeof filtros !== 'undefined' && filtros) {
  const parts = Object.keys(filtros).filter(k => filtros[k] !== undefined && filtros[k] !== '').map(k => encodeURIComponent(k) + '=' + encodeURIComponent(filtros[k]));
  baseQuery = parts.length ? parts.join('&') + '&' : '';
}
%>

<nav aria-label="Page navigation">
  <ul class="pagination justify-content-center">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="<%= rota %>?<%= baseQuery %>page=<%= Math.max(1, page-1) %>">Anterior</a>
    </li>

    <% const start = Math.max(1, page - 2); %>
    <% const end = Math.min(totalPages, page + 2); %>
    <% for (let p = start; p <= end; p++) { %>
      <li class="page-item <%= p === page ? 'active' : '' %>">
        <a class="page-link" href="<%= rota %>?<%= baseQuery %>page=<%= p %>"><%= p %></a>
      </li>
    <% } %>

    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="<%= rota %>?<%= baseQuery %>page=<%= Math.min(totalPages, page+1) %>">Próxima</a>
    </li>
  </ul>
  <p class="text-center small mb-0">Total: <%= totalItems %> • Página <%= page %> de <%= totalPages %></p>
</nav>
