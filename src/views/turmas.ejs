<%- include('partials/header') %>
  <%- include('partials/menu') %>
              <%- include("partials/css") %>

    <% const filtrosView=typeof filtros !=='undefined' ? filtros : {}; const paginationView=typeof pagination
      !=='undefined' ? pagination : {}; const turmasList=Array.isArray(turmas?.turmas) ? turmas.turmas : []; const
      salasList=Array.isArray(salas) ? salas : []; const turnosList=Array.isArray(turnos) ? turnos : []; const
      seriesList=Array.isArray(series) ? series : []; const anoLetivoList=Array.isArray(anoLetivo) ? anoLetivo : [];
      const fields=['id', 'text' , 'sigla' , 'id_ano_letivo' , 'id_serie' , 'id_turno' , 'id_salas' , 'id_status' ];
      const findOption=(items, id)=> items.find(item => String(item.id) === String(id));
      const optionName = (items, id) => findOption(items, id)?.text || findOption(items, id)?.nome || '-';
      const activeCount = turmasList.filter(turma => Number(turma.id_status) === 1).length;
      %>

      <main class="main-content">
        <section class="config-card">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h1 class="page-title mb-1"><i class="bi bi-people me-2"></i>Turmas</h1>
              <p class="text-muted mb-0">Selecione uma turma para visualizar os alunos.</p>
            </div>
            <button type="button" class="btn btn-primary" onclick="openTurmasModal(null)"><i
                class="bi bi-plus-lg me-1"></i>Nova turma</button>
          </div>

          <form class="card border-0 shadow-sm mb-4" method="get" action="/turmas">
            <div class="card-body row g-3 align-items-end">
              <div class="col-md-8"><label class="form-label" for="busca">Buscar turma</label>
                <div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span><input
                    id="busca" name="busca" class="form-control" value="<%= filtrosView.busca || '' %>"
                    placeholder="Nome ou sigla"></div>
              </div>
              <div class="col-md-4 d-flex gap-2"><button class="btn btn-outline-primary flex-grow-1"
                  type="submit">Buscar</button><a class="btn btn-outline-secondary" href="/turmas" title="Limpar busca"
                  aria-label="Limpar busca"><i class="bi bi-x-lg"></i></a></div>
            </div>
          </form>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="card stat-card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                  <div><small class="text-muted">Turmas na página</small>
                    <h2 class="mb-0 mt-1">
                      <%= turmasList.length %>
                    </h2>
                  </div>
                  <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-building"></i></div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card stat-card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                  <div><small class="text-muted">Ativas</small>
                    <h2 class="mb-0 mt-1">
                      <%= activeCount %>
                    </h2>
                  </div>
                  <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-check-circle"></i></div>
                </div>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h2 class="h5 mb-1">Turmas cadastradas</h2><small class="text-muted">Selecione uma turma para visualizar
                os alunos.</small>
            </div><span class="badge text-bg-light">
              <%= paginationView.totalItems || turmasList.length %> registros
            </span>
          </div>

          <form id="turmas-form" action="/turmas" method="post">
            <div class="row g-4" id="turmas-cards">
              <% turmasList.forEach(function (turma, idx) { const capacidade=Number(turma.capacidade) || 0; const
                alunos=Number(turma.alunos || turma.total_alunos) || 0; const vagas=Math.max(capacidade - alunos, 0);
                const ocupacao=capacidade ? Math.min(Math.round((alunos / capacidade) * 100), 100) : 0; %>
                <div class="col-xl-4 col-lg-6 turma-card-wrapper">
                  <article class="card turma-card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                      <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex gap-3">
                          <div class="turma-icon"><i class="bi bi-people"></i></div>
                          <div>
                            <h3 class="h5 mb-1">
                              <%= turma.text || '-' %>
                            </h3><small class="text-muted">
                              <%= turma.sigla || '-' %> • <%= optionName(seriesList, turma.id_serie) %>
                            </small>
                          </div>
                        </div><span
                          class="badge <%= Number(turma.id_status) === 1 ? 'text-bg-success' : 'text-bg-secondary' %>">
                          <%= Number(turma.id_status)===1 ? 'Ativa' : 'Inativa' %>
                        </span>
                      </div>
                      <hr>
                      <div class="row text-center mb-3">
                        <div class="col-4"><strong class="d-block">
                            <%= alunos %>
                          </strong><small class="text-muted">Alunos</small></div>
                        <div class="col-4"><strong class="d-block">
                            <%= capacidade %>
                          </strong><small class="text-muted">Capacidade</small></div>
                        <div class="col-4"><strong class="d-block">
                            <%= vagas %>
                          </strong><small class="text-muted">Vagas</small></div>
                      </div>
                      <div class="progress capacity-bar mb-3" role="progressbar" aria-label="Ocupação da turma"
                        aria-valuenow="<%= ocupacao %>" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width:<%= ocupacao %>%"></div>
                      </div>
                      <div class="d-flex justify-content-between align-items-center mb-3 text-muted small"><span><i
                            class="bi bi-sun me-1"></i>
                          <%= optionName(turnosList, turma.id_turno) %>
                        </span><span><i class="bi bi-door-open me-1"></i>
                          <%= optionName(salasList, turma.id_salas) %>
                        </span></div>
                      <a class="btn btn-outline-primary w-100 mt-auto" href="/turmas/<%= turma.id %>"><i
                          class="bi bi-eye me-1"></i>Ver detalhes</a>
                      <div class="d-flex gap-2 mt-2">
                        <a class="btn btn-sm btn-outline-primary flex-fill" href="/turmas/<%= turma.id %>"><i class="bi bi-person-plus me-1"></i>Adicionar alunos</a>
                        <a class="btn btn-sm btn-outline-secondary flex-fill" href="/turmas/<%= turma.id %>"><i class="bi bi-person-workspace me-1"></i>Adicionar professores</a>
                      </div>
                      <div class="mt-2 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                          onclick="openTurmasModal(<%= idx %>)" title="Editar turma" aria-label="Editar turma"><i
                            class="bi bi-pencil"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                          onclick="excluirTurma(<%= turma.id %>)" title="Excluir turma" aria-label="Excluir turma"><i
                            class="bi bi-trash"></i></button>
                      </div>
                    </div>
                  </article>
                </div>
                <% }) %>
            </div>
            <table class="d-none">
              <tbody id="turmas-tbody">
                <% turmasList.forEach(function (turma, idx) { %>
                  <tr data-index="<%= idx %>" class="turmas-row">
                    <td class="hidden-values">
                      <% fields.forEach(function (field) { %><input type="hidden" data-field="<%= field %>"
                          name="turmas[<%= idx %>][<%= field %>]"
                          value="<%= field === 'id_status' ? (turma[field] ?? 1) : (turma[field] ?? '') %>">
                        <% }) %>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </form>

          <% if (!turmasList.length) { %>
            <p class="series-empty text-center py-4" id="turmas-empty">Nenhuma turma encontrada.</p>
            <% } %>
              <div class="mt-4"><%- include('partials/paginations', { pagination: paginationView, filtros: filtrosView,
                  rota: '/turmas' }) %></div>
        </section>
      </main>

      <script>
        const TURMAS_FIELDS = ['id', 'text', 'sigla', 'id_ano_letivo', 'id_serie', 'id_turno', 'id_salas', 'id_status'];

        function getOrCreateTurmasModal() {
          let modal = document.getElementById('turmas-modal');
          if (modal) return modal;
          modal = document.createElement('div');
          modal.id = 'turmas-modal';
          modal.innerHTML = '<div class="modal-panel"><h3>Turma</h3><input type="hidden" id="modal-index" value="-1"><input type="hidden" id="modal-id"><div class="form-group"><label for="modal-text">Nome *</label><input id="modal-text" type="text" required></div><div class="form-group"><label for="modal-sigla">Sigla</label><input id="modal-sigla" type="text"></div><div class="form-group"><label for="modal-id_ano_letivo">Ano letivo</label><select id="modal-id_ano_letivo"><option value="">Selecione</option><% anoLetivoList.forEach(function (item) { %><option value="<%= item.id %>"><%= item.text || item.nome %></option><% }) %></select></div><div class="form-group"><label for="modal-id_serie">Série</label><select id="modal-id_serie"><option value="">Selecione</option><% seriesList.forEach(function (item) { %><option value="<%= item.id %>"><%= item.text || item.nome %></option><% }) %></select></div><div class="form-group"><label for="modal-id_turno">Turno</label><select id="modal-id_turno"><option value="">Selecione</option><% turnosList.forEach(function (item) { %><option value="<%= item.id %>"><%= item.text || item.nome %></option><% }) %></select></div><div class="form-group"><label for="modal-id_salas">Sala</label><select id="modal-id_salas"><option value="">Selecione</option><% salasList.forEach(function (item) { %><option value="<%= item.id %>"><%= item.text || item.nome %></option><% }) %></select></div><div class="form-group"><label for="modal-id_status">Status *</label><select id="modal-id_status"><option value="1">Ativa</option><option value="0">Inativa</option></select></div><div class="actions"><button type="button" class="btn-secondary" onclick="closeTurmasModal()">Cancelar</button><button type="button" class="btn-primary" onclick="saveTurmasModal()">Salvar</button></div></div>';
          modal.addEventListener('click', event => { if (event.target === modal) closeTurmasModal(); });
          document.body.appendChild(modal);
          return modal;
        }

        function openTurmasModal(index) { const modal = getOrCreateTurmasModal(); ModalHelper.openModal(modal, 'turmas', TURMAS_FIELDS, index, { id_status: '1' }); modal.querySelector('#modal-text')?.focus(); }
        function closeTurmasModal() { document.getElementById('turmas-modal')?.classList.remove('open'); }
        function saveTurmasModal() { const modal = document.getElementById('turmas-modal'); const values = ModalHelper.collectModalValues('turmas-modal', TURMAS_FIELDS); if (!modal || !values.text) { modal?.querySelector('#modal-text')?.focus(); return; } const idx = Number(modal.querySelector('#modal-index').value); ModalHelper.applyValuesToRow('turmas', TURMAS_FIELDS, [], idx, values, 'openTurmasModal', '/turmas/excluir'); ModalHelper.reindex('turmas', TURMAS_FIELDS, 'openTurmasModal'); closeTurmasModal(); document.getElementById('turmas-form').submit(); }
        function excluirTurma(id) { if (confirm('Tem certeza que deseja excluir esta turma?')) ModalHelper.submitDelete(`/turmas/excluir/${id}`); }
      </script>