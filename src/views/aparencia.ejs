<%- include('partials/header') %>
<%- include('partials/menu') %>
<%
    aparencia = typeof aparencia !== 'undefined' ? aparencia : {};
%>
<div class="main-content">
  <div class="page-header">
    <div>
      <h1>Aparência</h1>
      <p>Configurações visuais e temas da plataforma.</p>
    </div>
  </div>

  <section class="config-card">
    <div class="card-header">
      <div class="card-icon">🎨</div>
      <div>
        <h2>Personalização</h2>
        <p>Placeholder: ajuste cores, logo e estilos.</p>
      </div>
    </div>
    <div class="card-body">
      <form action="/aparencia" method="POST">
        <div class="form-grid">
           <div class="form-group">
                <label for="tema_sistema">Tema *</label>
                <select
                    id="tema_sistema"
                    name="tema_sistema"
                    required>
                    <option value="claro" <%= aparencia.tema_sistema === 'claro' ? 'selected' : '' %>>
                        Claro
                    </option>
                    <option value="escuro" <%= aparencia.tema_sistema === 'escuro' ? 'selected' : '' %>>
                        Escuro
                    </option>
                </select>
            </div>
            <div class="form-group">
                <label for="cor_principal">Cor principal *</label>

                <select
                    id="cor_principal"
                    name="cor_principal"
                    required
                >
                    <option value="#ff0000" <%= aparencia.cor_principal === '#ff0000' ? 'selected' : '' %>>
                        Vermelho
                    </option>

                    <option value="#00ff00" <%= aparencia.cor_principal === '#00ff00' ? 'selected' : '' %>>
                        Verde
                    </option>

                    <option value="#0000ff" <%= aparencia.cor_principal === '#0000ff' ? 'selected' : '' %>>
                        Azul
                    </option>

                    <option value="#ffff00" <%= aparencia.cor_principal === '#ffff00' ? 'selected' : '' %>>
                        Amarelo
                    </option>

                    <option value="#ff00ff" <%= aparencia.cor_principal === '#ff00ff' ? 'selected' : '' %>>
                        Magenta
                    </option>

                    <option value="#00ffff" <%= aparencia.cor_principal === '#00ffff' ? 'selected' : '' %>>
                        Ciano
                    </option>
                </select>
            </div>
            <div class="form-group">
                <label for="menu_lateral">Menu lateral *</label>
                <select
                    id="menu_lateral"
                    name="menu_lateral"
                    required
                >
                    <option value="true" <%= aparencia.menu_lateral === true ? 'selected' : '' %>>
                        Expandido
                    </option>
                    <option value="false" <%= aparencia.menu_lateral === false ? 'selected' : '' %>>
                        Compacto
                    </option>
                </select>
            </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary">Salvar</button>
        </div>
      </form>
    </div>
  </section>

</div>

</body>
</html>
