<%- include('partials/header') %>
<%- include('partials/menu') %>

<div class="config-container">
  <div class="page-header">
    <div>
      <h1>Configuração de Notas</h1>
      <p>Parâmetros de avaliação e notas.</p>
    </div>
  </div>

  <section class="config-card">
    <div class="card-header">
      <div class="card-icon">🧾</div>
      <div>
        <h2>Escalas e regras</h2>
        <p>Placeholder: configurar escalas de notas.</p>
      </div>
    </div>
    <div class="card-body">
      <form action="/configuracao_notas" method="POST">
        <% Object.keys(settings || {}).forEach(function(k){ %>
          <div class="form-group">
            <label><%= k %></label>
            <input type="text" name="settings[<%= k %>]" value="<%= settings[k] %>" />
          </div>
        <% }); %>

        <div class="form-group">
          <label>Novo campo</label>
          <input type="text" name="newKey" placeholder="chave" />
          <input type="text" name="newValue" placeholder="valor" />
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary">Salvar</button>
        </div>
      </form>
    </div>
  </section>

</div>

</body>
</html>
