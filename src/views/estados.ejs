<%- include('partials/header') %>
    <%- include('partials/menu') %>
<%
    filtros = typeof filtros !== 'undefined' ? filtros : {};
    pagination = typeof pagination !== 'undefined' ? pagination : {};
    uf = typeof uf !== 'undefined' ? uf : null;
    estados = typeof estados !== 'undefined' ? estados : [];
%>

<div class="main-content">

    <%- include('partials/filtros', {
            action: '/estados',
            filtros,
            fields: [
                { name: 'busca', label: 'Descrição', placeholder: 'Buscar por palavra', col: 'col-md-6' }
            ]
    }) %>

    <form id="formEstados" action="/estados" method="POST">

        <section class="config-card">

            <div class="card-header">
                <div class="card-icon">🌐</div>

                <div>
                    <h2>Lista de Estados</h2>
                    <p>Adicione, edite ou remova estados (UF) utilizados pelo sistema.</p>
                </div>
            </div>
            
            <div class="card-body">

                <div class="mb-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn-secondary" onclick="addParamsRow(document.getElementById('trClone'))">Adicionar linha</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th style="width: 45%">Descrição</th>
                                <th style="width: 25%">UF</th>
                                <th style="width: 10%">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="grid-params">
                            <% const itens = Array.isArray(estados) ? estados : [estados]; %>
                            <% itens.forEach((item, index) => { %>
                                <tr data-id="<%= item.id || '' %>">
                                    <td>
                                        <input type="hidden" name="itens[<%= index %>][id]" value="<%= item.id || '' %>">
                                        <input type="text" class="form-control" name="itens[<%= index %>][text]" value="<%= item.text || '' %>" placeholder="Ex: São Paulo">
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" name="itens[<%= index %>][uf]" value="<%= item.uf || '' %>" placeholder="Ex: SP">
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="removeParamsRow(this)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            <% }) %>

                              <!-- TR MODELO -->
                            <tr id="trClone" style="display: none;">
                            <td>
                                <input type="hidden" data-field="id">
                                <input
                                    type="text"
                                    class="form-control"
                                    data-field="text"
                                    placeholder="Ex: São Paulo"
                                >
                            </td>

                            <td>
                                <input
                                    type="text"
                                    class="form-control"
                                    data-field="uf"
                                    placeholder="Ex: SP"
                                    maxlength="2"
                                >
                            </td>

                            <td>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-danger"
                                    onclick="removeParamsRow(this)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>

                        </tr>
                        </tbody>
                    </table>
                </div>
                <small class="text-muted">Preencha uma linha por estado. Linhas vazias serão ignoradas ao salvar.</small>
                <div id="to-delete"></div>
            </div>

        </section>

        <%- include('partials/paginations', {
            pagination,
            filtros,
            rota: '/estados',
            query: `busca=${encodeURIComponent(filtros?.busca || '')}`
        }) %>

    </form>

    <!-- BOTÕES MOBILE -->
    <div class="mobile-actions">

        <button type="button" class="btn-secondary">Cancelar</button>

        <button type="submit" form="formEstados" class="btn-primary">Salvar alterações</button>

    </div>

</div>

</body>
</html>