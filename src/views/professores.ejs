<%- include('partials/header') %>
    <!-- Sidebar -->
    <%- include('partials/menu') %>
    <%- include("partials/css") %>
<%- include("partials/javascript", {
    javascript: ["professores"]
}) %>
   
  <div class="main-content">

   <%- include('partials/filtros', { action: '/professores', filtros, pageSizes: [10,25,50] }) %>

   <section class="config-card">
      <div style="text-align: right;">
          <button type="button" class="btn-primary series-new-btn" onclick="openProfessorModal(null)">+ Novo Professor</button>
      </div>
      <div class="card-header">
          <div class="card-icon"><i class="bi bi-person-workspace"></i></div>
          <div>
              <h2>Professores</h2>
              <p>Cadastre, consulte e gerencie os professores da instituição.</p>
          </div>
      </div>
     <div class="cards">
          <div class="card">
              <div class="card-icon"><i class="bi bi-people-fill"></i></div>
              <div>
                  <span>Total de Professores</span>
                  <span style="text-align: center;"><strong><%= professoresList.length %></strong></span>
              </div>
          </div>
          <div class="card">
              <div class="card-icon"><i class="bi bi-person-check-fill"></i></div>
              <div>
                  <span>Professores Ativos</span>
                  <span style="text-align: center;"><strong><%= statusProfessorList[0]?.total_ativos || 0 %></strong></span>
              </div>
          </div>
          <div class="card">
              <div class="card-icon"><i class="bi bi-person-x-fill"></i></div>
              <div>
                  <span>Professores Inativos</span>
                  <span style="text-align: center;"><strong><%= statusProfessorList[0]?.total_desativados || 0 %></strong></span>
              </div>
          </div>
      </div>
      <div class="card-body">
      <form id="professores-form" action="/professores" method="POST">
        <table class="professores-table">
          <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Disciplina</th>
                <th>Email</th>
                <th>Status</th>
              <th style="width: 10%">Ações</th>
            </tr>
          </thead>
          <tbody id="professores-tbody">
            <% professoresList.forEach(function (s, idx) { %>
              <tr data-index="<%= idx %>" class="professores-row">
                <td><span class="professores-id"><%= s.id || '' %></span></td>
                <td><span class="professores-nome"><%= s.nome || '' %></span></td>
                <td><span class="professores-disciplina"><%= s.disciplina_nome || '' %></span></td>
                <td><span class="professores-email"><%= s.email || '' %></span></td>
                <td><span class="professores-status"><%= s.id_status ? 'Ativo' : 'Inativo' %></span></td>
                <td class="professores-actions">
                  <button type="button" class="btn btn-sm btn-warning" onclick="openProfessorModal(<%= idx %>)"><i class="bi bi-pencil"></i></button>
                  <button type="button" class="btn btn-sm btn-danger" onclick="excluirProfessor(<%= s.id %>)"><i class="bi bi-trash"></i></button>
                </td>
                <td class="hidden-values" style="display:none">
                  <input type="hidden" data-field="id" name="professores[<%= idx %>][id]" value="<%= s.id || '' %>" />
                  <input type="hidden" data-field="nome" name="professores[<%= idx %>][nome]" value="<%= s.nome || '' %>" />
                  <input type="hidden" data-field="nome_social" name="professores[<%= idx %>][nome_social]" value="<%= s.nome_social || '' %>" />
                  <input type="hidden" data-field="cpf" name="professores[<%= idx %>][cpf]" value="<%= s.cpf || '' %>" />
                  <input type="hidden" data-field="data_nascimento" name="professores[<%= idx %>][data_nascimento]" value="<%= s.data_nascimento ? new Date(s.data_nascimento).toISOString().slice(0,10) : '' %>" />
                  <input type="hidden" data-field="sexo" name="professores[<%= idx %>][sexo]" value="<%= s.sexo || '' %>" />
                  <input type="hidden" data-field="id_disciplina" name="professores[<%= idx %>][id_disciplina]" value="<%= s.id_disciplina || '' %>" />
                  <input type="hidden" data-field="carga_horaria" name="professores[<%= idx %>][carga_horaria]" value="<%= s.carga_horaria || '' %>" />
                  <input type="hidden" data-field="id_status" name="professores[<%= idx %>][id_status]" value="<%= s.id_status || '1' %>" />
                  <input type="hidden" data-field="email" name="professores[<%= idx %>][email]" value="<%= s.email || '' %>" />
                  <input type="hidden" data-field="has_senha" name="professores[<%= idx %>][has_senha]" value="<%= s.has_senha ? 1 : '' %>" />
                  <input type="hidden" data-field="telefone" name="professores[<%= idx %>][telefone]" value="<%= s.telefone || '' %>" />
                  <input type="hidden" data-field="celular" name="professores[<%= idx %>][celular]" value="<%= s.celular || '' %>" />
                  <input type="hidden" data-field="cep" name="professores[<%= idx %>][cep]" value="<%= s.cep || '' %>" />
                  <input type="hidden" data-field="endereco" name="professores[<%= idx %>][endereco]" value="<%= s.endereco || '' %>" />
                  <input type="hidden" data-field="numeros" name="professores[<%= idx %>][numeros]" value="<%= s.numeros || '' %>" />
                  <input type="hidden" data-field="complemento" name="professores[<%= idx %>][complemento]" value="<%= s.complemento || '' %>" />
                  <input type="hidden" data-field="bairro" name="professores[<%= idx %>][bairro]" value="<%= s.bairro || '' %>" />
                  <input type="hidden" data-field="cidade" name="professores[<%= idx %>][cidade]" value="<%= s.cidade || '' %>" />
                  <input type="hidden" data-field="id_estado" name="professores[<%= idx %>][id_estado]" value="<%= s.id_estado || '' %>" />
                  <input type="hidden" data-field="matricula" name="professores[<%= idx %>][matricula]" value="<%= s.matricula || '' %>" />
                  <input type="hidden" data-field="registro_profissional" name="professores[<%= idx %>][registro_profissional]" value="<%= s.registro_profissional || '' %>" />
                  <input type="hidden" data-field="data_admissao" name="professores[<%= idx %>][data_admissao]" value="<%= s.data_admissao ? new Date(s.data_admissao).toISOString().slice(0,10) : '' %>" />
                  <input type="hidden" data-field="idFormacao" name="professores[<%= idx %>][idFormacao]" value="<%= s.idFormacao || '' %>" />
                  <input type="hidden" data-field="area_formacao" name="professores[<%= idx %>][area_formacao]" value="<%= s.area_formacao || '' %>" />
                  <input type="hidden" data-field="observacoes" name="professores[<%= idx %>][observacoes]" value="<%= s.observacoes || '' %>" />
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <% if (!professoresList.length) { %>
          <p class="series-empty" id="professores-empty">Nenhum professor cadastrado ainda.</p>
        <% } %>
        </form>
        </div>

 <div>
          <%- include('partials/botoes', { newAction: 'openProfessorModal(null)',
          showExport: true,
          exportAction: 'ExportExcel("professores-exportar-excel")',
          showImport: true,
          importAction: 'ImportExcel("professores-importar-excel")'
        }) %>

    </div>
     <div class="form-actions" style="margin-top: 20px; text-align: center;"></div>
     <%- include('partials/paginations', {
          pagination,
          filtros,
          rota: '/professores',
          query: `busca=${encodeURIComponent(filtros?.busca || '')}`
      }) %>
    </div>
  </section>
<script>
  window.PROFESSOR_DISCIPLINAS = <%- JSON.stringify(disciplinasCatalogo.reduce(function (acc, d) { acc[d.id] = d.text; return acc; }, {})) %>;
</script>
<script src="/javascript/professores.js"></script>
