<%- include('partials/header') %>
<%- include('partials/menu') %>
<%- include("partials/css") %>
<%- include("partials/javascript", {
    javascript: ["anosLetivos"]
}) %>

<div class="main-content">
  <section class="config-card">
    <div style="text-align: right;">
      <button type="button" class="btn-primary series-new-btn" onclick="openAnosModal(null)">+ Novo Ano Letivo</button>
    </div>
    <div class="card-header">
      <div class="card-icon">📅</div>
      <div>
        <h2>Anos Letivos</h2>
        <p>Períodos escolares com datas de início e fim.</p>
      </div>
    </div>
    <div class="cards">
          <div class="card">
              <div class="card-icon"><i class="bi bi-people-fill"></i></div>
              <div>
                  <span>Total de Alunos</span>
                  <span style="text-align: center;"><strong>
                         0
                      </strong></span>
              </div>
          </div>
          <div class="card">
              <div class="card-icon"><i class="bi bi-person-check-fill"></i></div>
              <div>
                  <span>Alunos Ativos</span>
                  <span style="text-align: center;"><strong>0</strong></span>
              </div>
          </div>
          <div class="card">
              <div class="card-icon"><i class="bi bi-person-x-fill"></i></div>
              <div>
                  <span>Alunos Inativos</span>
                  <span style="text-align: center;"><strong>0</strong></span>
              </div>
    </div>
      </div>

    <div class="card-body">
      <form id="anos-form" action="/anos-letivos" method="POST">
        <table class="series-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Ano</th>
              <th>Início</th>
              <th>Fim</th>
              <th>Atual</th>
              <th style="width: 10%">Ações</th>
            </tr>
          </thead>
          <tbody id="anos-tbody">
            <% anos.forEach(function (s, idx) { %>
              <tr data-index="<%= idx %>" class="anos-row">
                <td><span class="ano-id"><%= s.id || '' %></span></td>
                <td><span class="ano-ano"><%= s.ano_letivo || s.ano || '' %></span></td>
                <td><span class="ano-inicio"><%= new Date(s.data_inicio).toLocaleDateString('pt-BR') %></span></td>
                <td><span class="ano-fim"><%= new Date(s.data_fim).toLocaleDateString('pt-BR') %></span></td>
                <td><span class="ano-atual"><%= s.atual ? 'Sim' : 'Não' %></span></td>
                <td class="ano-actions">
                  <button type="button" class="btn btn-sm btn-warning" onclick="openAnosModal(<%= idx %>)"><i class="bi bi-pencil"></i></button>
                  <button type="button" class="btn btn-sm btn-danger" onclick="excluirAno(<%= s.id %>)"><i class="bi bi-trash"></i></button>
                </td>
                <td class="hidden-values" style="display:none">
                  <input type="hidden" data-field="id" name="anos[<%= idx %>][id]" value="<%= s.id || '' %>" />
                  <input type="hidden" data-field="anoLetivo" name="anos[<%= idx %>][anoLetivo]" value="<%= s.ano_letivo || s.ano || '' %>" />
                  <input type="hidden" data-field="dataInicio" name="anos[<%= idx %>][dataInicio]" value="<%= s.data_inicio ? new Date(s.data_inicio).toISOString().slice(0,10) : '' %>" />
                  <input type="hidden" data-field="dataFim" name="anos[<%= idx %>][dataFim]" value="<%= s.data_fim ? new Date(s.data_fim).toISOString().slice(0,10) : '' %>" />
                  <input type="hidden" data-field="status" name="anos[<%= idx %>][status]" value="<%= s.status || '1' %>" />
                  <input type="hidden" data-field="atual" name="anos[<%= idx %>][atual]" value="<%= s.atual ? '1' : '0' %>" />
                  <input type="hidden" data-field="text" name="anos[<%= idx %>][text]" value="<%= s.text || '' %>" />
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <% if (!anos.length) { %>
          <p class="series-empty" id="anos-empty">Nenhum ano letivo cadastrado ainda.</p>
        <% } %>
        <div id="to-delete"></div>
                      <%- include('partials/botoes', { newAction: 'openAnosModal(null)' }) %>

                        </div>
      </form>
    </div>
  </section>
</div>

<script>
 
</script>
