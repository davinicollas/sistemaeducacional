        id="painelAlunos"
        style="display:none;"
    >

        <div class="card-header bg-white py-3">

            <div class="d-flex
                        flex-column flex-md-row
                        justify-content-between
                        align-items-md-center
                        gap-3">

                <div>

                    <h5 class="mb-1" id="nomeTurmaSelecionada">
